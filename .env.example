# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WHATSAPP / EVOLUTION API (substitui a Meta Cloud API oficial)
# EVOLUTION_API_URL=http://129.80.27.159:8080   # IP da VM Oracle Cloud (Railway cancelado)
# EVOLUTION_API_KEY=                   # API Key global configurada na Evolution API (AUTHENTICATION_API_KEY)
# EVOLUTION_INSTANCE_NAME=             # Nome da instância criada na Evolution API (ex: frota-bot)
# EVOLUTION_WEBHOOK_SECRET=            # Token secreto que a Evolution API envia no header `apikey` do webhook

# ─── PÁGINA /uso-apis — cadastro de contas (email + final do cartão por serviço) ───
# Chave pra cifrar (AES-256-GCM) os cadastros sensíveis em repouso. Use uma frase
# aleatória LONGA. Sem ela, salvar/ler cadastros lança. PÔR no .env.local / Vercel.
# A página em si é restrita a usuários com role admin/master.
# USO_APIS_ENC_KEY=

# ─── GEMINI — limites de cota (guarda proativa do bot) ───
# Se SETADAS, antes de chamar o Gemini o bot checa quantas chamadas já fez no
# minuto/dia; estourou → cai no menu determinístico (grátis), sem perder a mensagem.
# Se NÃO setar (caso tier PAGO), a guarda fica DESLIGADA e o bot não gasta as 2
# queries por mensagem (mais rápido). Ligue só no FREE tier (ex.: RPM=5, RPD=250).
# Limites reais: https://ai.google.dev/gemini-api/docs/rate-limits.
# GEMINI_RPM=5     # requisições por minuto (free tier 2.5-flash ≈ 5)
# GEMINI_RPD=250   # requisições por dia (free tier ≈ 250)

# OUTROS SERVIÇOS
# SENTRY_DSN=your_sentry_dsn          # o código lê SENTRY_DSN ?? NEXT_PUBLIC_SENTRY_DSN

# ─── CLOUDFLARE R2 — storage de FOTOS do sistema (OBRIGATÓRIO) ───
# Onde as fotos (avaria/cupom/odômetro) ficam guardadas. 10GB grátis, egress zero.
# Upload IMPLEMENTADO (src/lib/storage/r2.ts). Sem estas chaves, o helper faz
# passthrough e a foto vira base64 no Postgres (incha o banco) → setar é obrigatório.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=frota-storage
# R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ─── ROUTING MVP — Fase 1 (sempre necessárias) ───
# VIACEP_URL=https://viacep.com.br/ws
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# ─── GOOGLE GEOCODING (opcional) — geocoder principal da captura ───
# Sem a chave, o sistema usa só o fluxo grátis (Nominatim + ViaCEP). Com a chave,
# usa o Google atrás de cache + cota mensal (ver db/migration_geocode_google.sql).
# GOOGLE_MAPS_API_KEY=                  # chave do Google Cloud (Geocoding API). PÔR SÓ no .env.local / Vercel, NUNCA commitar.
# GEOCODE_LIMITE_MENSAL=9800            # teto de chamadas/mês ao Google; estourou → cai no ViaCEP (default 9800, logo abaixo do grátis ~10k → sem cobrança)

# ─── ROUTING MVP ─ Preencher com IP da Oracle VM (já provisionada) ───
# OSRM_URL=http://129.80.27.159:5000
# VROOM_URL=http://129.80.27.159:3000
# OVERPASS_URL=http://129.80.27.159:12345/api/interpreter

# ─── Gemini API (Google AI Studio ─ obrigatório pro bot WhatsApp) ───
# GEMINI_API_KEY=                       # aistudio.google.com/app/apikey

# ─── Deepgram API (Speech-to-Text ─ obrigatório pro áudio do bot) ───
# DEEPGRAM_API_KEY=                     # deepgram.com → API Keys
